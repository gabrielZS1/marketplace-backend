# Copie para .env (ignorado pelo git) e preencha. O backend carrega o .env
# automaticamente em dev (DotenvEnvironmentPostProcessor). Em produção, defina
# como variáveis de ambiente do host (Railway) — o .env é ignorado lá.

# --- Banco ---
DB_URL=jdbc:postgresql://localhost:5433/marketplace
DB_USERNAME=marketplace_admin
DB_PASSWORD=troque_esta_senha

# --- JWT (>= 64 chars aleatórios: openssl rand -hex 64) ---
JWT_SECRET=

# --- Mercado Pago ---
# Sandbox: TEST-...   Produção: APP_USR-...
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:8082
ADMIN_EMAIL=voce@exemplo.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- E-mail (Resend) ---
# Sem RESEND_API_KEY os e-mails são só logados no console.
RESEND_API_KEY=
RESEND_FROM=Glowly <onboarding@resend.dev>

# --- Entrar com Google ---
# Client IDs OAuth (Web, iOS, Android) separados por vírgula. Vazio = desativado.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Verificação de e-mail ---
# true só depois de ter domínio de e-mail configurado no Resend.
REQUIRE_VERIFIED_EMAIL=false

# --- CAPTCHA no cadastro (Cloudflare Turnstile) ---
# Site key vai no app (app.json extra.turnstileSiteKey); secret vem aqui.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- Produção ---
# SPRING_PROFILES_ACTIVE=prod
# RATELIMIT_BEHIND_PROXY=true
